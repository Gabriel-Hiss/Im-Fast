{
  "schemaVersion": 1,
  "id": "imfast",
  "version": "${version}",
  "name": "I'm Fast",
  "description": "A modern solution using mixin to remove minecraft speed limit",
  "authors": ["Bielhiss"],
  "contact": {},
  "license": "LGPL-3.0",
  "icon": "assets/imfast/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.biel.mod.client.imfastClient"
    ],
    "main": [
      "com.biel.mod.imfast"
    ]
  },
  "mixins": [
    "imfast.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
